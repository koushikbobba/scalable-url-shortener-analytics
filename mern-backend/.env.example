# ─────────────────────────────────────────────
#  LinkStream MERN Backend – Environment Config
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/linkstream

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL Settings
SHORT_DOMAIN_BASE=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5173

# Rate Limiting (requests per minute)
RATE_LIMIT_ANON=30
RATE_LIMIT_AUTH=60
RATE_LIMIT_LINK_CREATE=20

# Analytics
ANALYTICS_BATCH_SIZE=100
CLICK_EVENT_RETENTION_DAYS=90

# Prometheus metrics path (optional, leave blank to disable)
METRICS_SECRET=

# Logging
LOG_LEVEL=info
